{
  "name": "@fluux/omemo-plugin",
  "version": "0.0.0",
  "description": "OMEMO 2 E2EEPlugin adapter for the Fluux SDK, built on @fluux/omemo.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./devices": {
      "types": "./dist/devices.d.ts",
      "import": "./dist/devices.js",
      "require": "./dist/devices.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fluux/omemo": "*",
    "@fluux/sdk": "*",
    "@xmpp/client": "^0.14.0",
    "ltx": "^3.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.0.0",
    "tsup": "^9.0.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.53.0",
    "vitest": "^5.0.0"
  }
}
