+
+Mechanism.prototype.response = function response({ authzid, username, password }) {
+  // RFC 4616: PLAIN fields are UTF-8; the SASL layer base64-encodes binary strings.
+  const bytes = new TextEncoder().encode(`${authzid ?? ""}\0${username}\0${password}`);
+  let binary = "";
+  for (const byte of bytes) {
+    binary += String.fromCharCode(byte);
+  }
+  return binary;
+};
+
