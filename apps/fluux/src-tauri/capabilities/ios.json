{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "ios",
  "description": "iOS shell with native XMPP TCP/TLS proxy, uploads, media cache and link previews",
  "platforms": [
    "iOS"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:path:default",
    "fs:allow-appcache-write-recursive",
    "fs:allow-appcache-read-recursive",
    "fs:allow-appcache-meta-recursive",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://*" },
        { "url": "https://*:*/**" },
        { "url": "http://*" },
        { "url": "http://*:*/**" }
      ]
    },
    "http:allow-fetch-read-body",
    "http:allow-fetch-cancel",
    "os:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "app-settings:*" }]
    },
    "share-inbox:default",
    "push:default",
    "share-sheet:default",
    "background-task:default",
    "ios-feedback:default",
    "deep-link:default",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify",
    "notification:allow-register-listener",
    "notification:allow-remove-listener"
  ]
}
