diff --git a/apps/fluux/src/utils/reproProbe.ts b/apps/fluux/src/utils/reproProbe.ts
new file mode 100644
index 00000000..b8befb50
--- /dev/null
+++ b/apps/fluux/src/utils/reproProbe.ts
@@ -0,0 +1,94 @@
+// LAB ONLY (FLM-258 reproduction, never committed): timestamped probe lines
+// forwarded to the native log through console.log.
+import { connectionStore, chatStore, roomStore } from '@fluux/sdk'
+
+function state(): string {
+  let focus = 'n/a'
+  try { focus = String(document.hasFocus()) } catch { /* ignore */ }
+  return `vis=${document.visibilityState} hasFocus=${focus} windowVisible=${connectionStore.getState().windowVisible} status=${connectionStore.getState().status}`
+}
+
+export function repro(event: string, detail = ''): void {
+  const now = Date.now()
+  console.log(`[REPRO] t=${now} ${event} ${detail} | ${state()}`)
+}
+
+let started = false
+let openRoom: ((jid: string) => unknown) | undefined
+export function setReproOpenRoom(fn: (jid: string) => unknown): void { openRoom = fn }
+let openConv: ((jid: string) => unknown) | undefined
+export function setReproOpen(fn: (jid: string) => unknown): void { openConv = fn }
+export function startReproProbe(): void {
+  if (started) return
+  started = true
+  repro('probe-start')
+  // 1 s timer: a late tick means JS timers were throttled or the process was suspended.
+  let last = Date.now()
+  let ticks = 0
+  setInterval(() => {
+    const now = Date.now()
+    const gap = now - last
+    last = now
+    ticks++
+    if (gap > 1500) repro('timer-late', `gapMs=${gap}`)
+    if (ticks % 15 === 0) repro('heartbeat', `gapMs=${gap}`)
+  }, 1000)
+  // Store-level arrival, before any notification filter.
+  const seen = new Map<string, string>()
+  for (const [id, m] of chatStore.getState().lastArrivedMessage ?? new Map()) seen.set(id, m.id)
+  chatStore.subscribe((st) => {
+    for (const [id, m] of st.lastArrivedMessage ?? new Map()) {
+      if (seen.get(id) === m.id) continue
+      seen.set(id, m.id)
+      const conv = st.conversations.get(id)
+      repro('store-arrival', `conv=${id} active=${st.activeConversationId === id} unread=${conv?.unreadCount} body=${JSON.stringify(m.body?.slice(0, 60))}`)
+      reproControl(m.body, openConv)
+    }
+  })
+  const seenRoom = new Map<string, string>()
+  for (const [id, m] of roomStore.getState().lastArrivedMessage ?? new Map()) seenRoom.set(id, m.id)
+  roomStore.subscribe((st) => {
+    for (const [id, m] of st.lastArrivedMessage ?? new Map()) {
+      if (seenRoom.get(id) === m.id) continue
+      seenRoom.set(id, m.id)
+      const meta = st.roomMeta.get(id)
+      repro('store-arrival-room', `room=${id} active=${st.activeRoomJid === id} unread=${meta?.unreadCount} body=${JSON.stringify(m.body?.slice(0, 60))}`)
+      reproControl(m.body, openConv)
+    }
+  })
+  document.addEventListener('visibilitychange', () => repro('visibilitychange'))
+  window.addEventListener('focus', () => repro('focus'))
+  window.addEventListener('blur', () => repro('blur'))
+}
+
+/** LAB ONLY: a chat body "CTRL close|hide|minimize" drives the window like the user would. */
+export function reproControl(body: string | undefined, openConversation?: (jid: string) => unknown): boolean {
+  const m = /^CTRL (\w+)/.exec(body ?? '')
+  if (!m) return false
+  const action = m[1]
+  repro('control', action)
+  void (async () => {
+    try {
+      if (action === 'close') {
+        const { getCurrentWindow } = await import('@tauri-apps/api/window')
+        await getCurrentWindow().close()
+      } else if (action === 'hide') {
+        const { hide } = await import('@tauri-apps/api/app')
+        await hide()
+      } else if (action === 'open') {
+        await openConversation?.('bob@localhost')
+      } else if (action === 'openroom') {
+        await openRoom?.('lab@conference.localhost')
+      } else if (action === 'unselect') {
+        chatStore.getState().setActiveConversation(null)
+      } else if (action === 'minimize') {
+        const { getCurrentWindow } = await import('@tauri-apps/api/window')
+        await getCurrentWindow().minimize()
+      }
+      repro('control-done', action)
+    } catch (err) {
+      repro('control-failed', `${action} ${String(err)}`)
+    }
+  })()
+  return true
+}
